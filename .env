# Copy this file to .env (defaults below already work with zero setup)

# SQLite needs nothing installed. To use Postgres instead, e.g.:
# DATABASE_URL=postgresql://user:pass@localhost:5432/dataforge
DATABASE_URL=sqlite:///./dataforge.db

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Local disk stands in for HDFS during development.
STORAGE_DIR=./storage
MODEL_DIR=./model_store

# Comma-separated list of origins allowed to call this API from the browser
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Safety cap so a huge CSV doesn't make training run for an hour during a demo.
# Set to 0 to disable.
MAX_TRAINING_ROWS=20000
